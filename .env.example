EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Backend base URL. Defaults to http://localhost:8000 if unset, which only
# reaches the backend from a simulator/web on the same machine — a physical
# device needs your dev machine's LAN IP instead, e.g. http://192.168.1.23:8000
EXPO_PUBLIC_API_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_API_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=